<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <TextView android:id="@+id/title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="10dp"
        android:gravity="center" android:textStyle="bold" android:textSize="18sp"
        android:textColor="@color/white" android:background="@color/ink"/>
    <org.mozilla.geckoview.GeckoView android:id="@+id/gecko"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
