<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cream" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="28dp" android:layout_gravity="center">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="معهد بن عوف" android:textColor="@color/ink" android:textSize="30sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="اختر الحساب" android:textColor="@color/ink" android:textSize="17sp" android:layout_marginBottom="24dp"/>
<Button android:id="@+id/manager" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="المديرة" android:background="@drawable/button_bg" android:layout_marginBottom="12dp"/>
<Button android:id="@+id/secretary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="أمينة السر" android:background="@drawable/button_bg" android:layout_marginBottom="12dp"/>
<Button android:id="@+id/supervisor" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الموجّهة" android:background="@drawable/button_bg" android:layout_marginBottom="12dp"/>
<Button android:id="@+id/teacher" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="المعلّمة" android:background="@drawable/button_bg" android:layout_marginBottom="12dp"/>
<Button android:id="@+id/student" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="الطالبة" android:background="@drawable/button_bg"/>
</LinearLayout></ScrollView>
